<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:id="@+id/chordsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="Аккорды"
                android:textAppearance="@style/TextAppearance.GuitarTuner.ScreenTitle"/>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleChordMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/btnModeLibrary"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Библиотека"/>

                <Button
                    android:id="@+id/btnModeBuilder"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Конструктор"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- ===== библиотека: стандартные аккорды по группам ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/libraryCard"
                style="@style/Widget.GuitarTuner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/libraryGroups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Выберите аккорд"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.CardTitle"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== аккорд: название, диаграмма, проверка игры ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GuitarTuner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textChordCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Аккорд"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.CardTitle"/>

                    <TextView
                        android:id="@+id/textChordName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.BigNote"
                        android:textSize="64sp"/>

                    <TextView
                        android:id="@+id/textChordInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceTitleSmall"/>

                    <TextView
                        android:id="@+id/textChordNotes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_info_pill"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSecondaryContainer"/>

                    <com.example.guitartuner.views.ChordDiagramView
                        android:id="@+id/chordDiagram"
                        android:layout_width="260dp"
                        android:layout_height="300dp"
                        android:layout_marginTop="8dp"/>

                    <!-- конструктор: позиция на грифе и подсказка -->
                    <LinearLayout
                        android:id="@+id/builderPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnBaseFretDown"
                                style="@style/Widget.GuitarTuner.RoundButton"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="Ближе к порожку"
                                android:text="−"/>

                            <TextView
                                android:id="@+id/textBaseFret"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Лады 1–5"
                                android:textAppearance="?attr/textAppearanceTitleSmall"/>

                            <Button
                                android:id="@+id/btnBaseFretUp"
                                style="@style/Widget.GuitarTuner.RoundButton"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="Дальше по грифу"
                                android:text="+"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="6dp"
                            android:text="Нажмите на лад, чтобы поставить палец (ещё раз — убрать). Над порожком: o — открытая, × — не звучит"
                            android:textAppearance="@style/TextAppearance.GuitarTuner.Hint"/>

                        <Button
                            android:id="@+id/btnClearShape"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Очистить"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textChordHeard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Нажмите «Сыграть» и ударьте по струнам"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Label"/>

                    <TextView
                        android:id="@+id/textChordScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_info_pill"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="Сыграно верно: 0"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSecondaryContainer"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnChordListen"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:text="🔊 Послушать"/>

        <Button
            android:id="@+id/btnChordPlay"
            style="@style/Widget.GuitarTuner.NeonButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="СЫГРАТЬ"/>
    </LinearLayout>

    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/gt_hit"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"/>

</FrameLayout>
