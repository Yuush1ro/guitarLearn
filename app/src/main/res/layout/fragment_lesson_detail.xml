<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/textLessonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:text="Урок"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- переключение вида: бегущие ноты / гриф -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleViewMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btnViewTab"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Бегущие ноты"/>

            <Button
                android:id="@+id/btnViewFretboard"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Гриф"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- выбор участка грифа (только для хроматического урока) -->
        <LinearLayout
            android:id="@+id/regionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textRegion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"/>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/rangeRegion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:valueFrom="0"
                android:valueTo="12"/>
        </LinearLayout>

        <!-- текущая нота -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="120dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textCurrentNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="72sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/textHeard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Нажмите ИГРАТЬ"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/textProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textSize="16sp"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp">

            <com.example.guitartuner.views.TabView
                android:id="@+id/tabView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <com.example.guitartuner.views.FretboardView
                android:id="@+id/fretboardView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>
        </FrameLayout>

        <Button
            android:id="@+id/btnPlayLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="ИГРАТЬ"/>
    </LinearLayout>

    <!-- зелёная вспышка при верной ноте; поверх всего, касания не перехватывает -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#4CAF50"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"/>

</FrameLayout>
