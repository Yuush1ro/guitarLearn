<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:id="@+id/metronomeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="Метроном"
                android:textAppearance="@style/TextAppearance.GuitarTuner.ScreenTitle"/>

            <!-- ===== визуализация и темп ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GuitarTuner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textBpm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.BigNote"
                        android:textSize="72sp"/>

                    <TextView
                        android:id="@+id/textTempoName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BPM · Allegro"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Label"/>

                    <com.example.guitartuner.views.MetronomeView
                        android:id="@+id/metronomeView"
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Нажмите на долю: акцент → обычная → без звука"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Hint"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== темп ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GuitarTuner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Скорость"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.CardTitle"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnBpmDown"
                            style="@style/Widget.GuitarTuner.RoundButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="Медленнее на 1"
                            android:text="−"/>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderBpm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="Темп"
                            android:stepSize="1"
                            android:valueFrom="30"
                            android:valueTo="250"/>

                        <Button
                            android:id="@+id/btnBpmUp"
                            style="@style/Widget.GuitarTuner.RoundButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="Быстрее на 1"
                            android:text="+"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnBpmMinus5"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="−5"/>

                        <Button
                            android:id="@+id/btnTap"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1.4"
                            android:text="Тап"/>

                        <Button
                            android:id="@+id/btnBpmPlus5"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="+5"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="«Тап» — отстучите темп пальцем, метроном подстроится"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Hint"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== размер и длительность ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GuitarTuner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Размер такта"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.CardTitle"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="4dp">

                        <Button
                            android:id="@+id/btnBeatsDown"
                            style="@style/Widget.GuitarTuner.RoundButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="Меньше долей"
                            android:text="−"/>

                        <TextView
                            android:id="@+id/textTimeSignature"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="4/4"
                            android:textAppearance="?attr/textAppearanceHeadlineMedium"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold"/>

                        <Button
                            android:id="@+id/btnBeatsUp"
                            style="@style/Widget.GuitarTuner.RoundButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="Больше долей"
                            android:text="+"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:text="Доля такта"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Label"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupDenominator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDen2"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/2"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDen4"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/4"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDen8"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/8"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDen16"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/16"/>
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:text="Длительность щелчков"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Label"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSubdivision"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSub1"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="♩ Доли"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSub2"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="♫ Восьмые"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSub3"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Триоли"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSub4"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="♬ Шестнадцатые"/>
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Сколько щелчков на каждую долю: 1, 2, 3 или 4"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Hint"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== звук ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GuitarTuner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Звук"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.CardTitle"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        app:selectionRequired="true"
                        app:singleSelection="true"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:text="Громкость"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Label"/>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="Громкость"
                        android:stepSize="5"
                        android:valueFrom="10"
                        android:valueTo="100"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnMetronomeStart"
            style="@style/Widget.GuitarTuner.NeonButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="СТАРТ"/>
    </FrameLayout>

</FrameLayout>
