<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:id="@+id/trainerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="Тренировка нот"
                android:textAppearance="@style/TextAppearance.GuitarTuner.ScreenTitle"/>

            <!-- ===== Блок 1: что тренируем ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GuitarTuner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Что тренируем"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.CardTitle"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:text="Тоника — от какой ноты строится гамма"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Label"/>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupRoot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true"/>
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:text="Гамма"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Label"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupScale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMajor"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Мажор"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMinor"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Минор"/>
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:text="Пентатоника"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Label"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupPentatonic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPentaMajor"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Мажорная"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPentaMinor"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Минорная"/>
                    </com.google.android.material.chip.ChipGroup>

                    <!-- выбранная гамма и её ноты -->
                    <TextView
                        android:id="@+id/textScaleNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_info_pill"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSecondaryContainer"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:text="Ничего не выбрано — тренируются все 12 нот"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Hint"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Блок 2: нота, которую нужно сыграть ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GuitarTuner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Сыграйте ноту"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.CardTitle"/>

                    <TextView
                        android:id="@+id/textTargetNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.BigNote"
                        android:textSize="96sp"/>

                    <TextView
                        android:id="@+id/textHeard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Нажмите СТАРТ и сыграйте показанную ноту в любой октаве"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Label"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_info_pill"
                            android:paddingStart="14dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="6dp"
                            android:text="Верно: 0"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSecondaryContainer"/>

                        <TextView
                            android:id="@+id/textStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_info_pill"
                            android:paddingStart="14dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="6dp"
                            android:text="Серия: 0"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSecondaryContainer"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnListenTrainer"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🔊  Послушать ноту"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Блок 3: гриф ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GuitarTuner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Гриф"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.CardTitle"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchShowNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Показывать, где играть ноту"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchRegion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Только участок грифа"/>

                    <TextView
                        android:id="@+id/textRegionHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="4dp"
                        android:textAppearance="@style/TextAppearance.GuitarTuner.Hint"
                        android:visibility="gone"/>

                    <com.example.guitartuner.views.FretboardView
                        android:id="@+id/fretboardView"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- кнопка всегда видна внизу экрана -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnStartTrainer"
            style="@style/Widget.GuitarTuner.NeonButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="СТАРТ"/>
    </FrameLayout>

    <!-- зелёная вспышка при верной ноте; поверх всего, касания не перехватывает -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/gt_hit"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"/>

</FrameLayout>
